; PROTO-001: bounded C01 experiment, built-in rendering only.
config_version=5

[application]
config/name="C01 - Shadow Printshop Prototype"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.0", "GL Compatibility")

[display]
window/size/viewport_width=1120
window/size/viewport_height=840
window/size/window_width_override=1120
window/size/window_height_override=840
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08, 0.1, 0.14, 1)
