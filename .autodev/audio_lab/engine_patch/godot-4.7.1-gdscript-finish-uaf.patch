+	Vector<Ref<GDScript>> scripts;
+	for (SelfList<GDScript> *s = script_list.first(); s; s = s->next()) {
+		scripts.push_back(Ref<GDScript>(s->self()));
+	}
+	for (Ref<GDScript> &scr : scripts) {
 		if (scr.is_valid()) {
 			for (KeyValue<StringName, GDScriptFunction *> &E : scr->member_functions) {
 				GDScriptFunction *func = E.value;
@@ -2260,8 +2261,9 @@ void GDScriptLanguage::finish() {
 			// check
 			scr->clear();
 		}
-		s = s->next();
 	}
+	// Scripts whose references were all broken are released here, together.
+	scripts.clear();
 	script_list.clear();
 	function_list.clear();
 
